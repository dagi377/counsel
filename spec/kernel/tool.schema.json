{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "CONTRACT: frozen once on main; changes are additive only and need a docs/QUESTIONS.md entry. Source: spec/eng/k1-kernel.html (Registry). Validated at boot; registered data that fails it stops boot.",
  "title": "Tool",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "kind",
    "input",
    "capability"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "kind": {
      "enum": [
        "read",
        "report",
        "write"
      ]
    },
    "input": {
      "type": "object",
      "description": "an embedded JSON Schema document"
    },
    "capability": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
      "description": "module-prefixed id, e.g. <module>.<name>"
    }
  },
  "$id": "https://counsel.local/spec/kernel/tool.schema.json"
}
