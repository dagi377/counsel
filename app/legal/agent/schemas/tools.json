[
 {
  "name": "search_matters",
  "kind": "read",
  "capability": "matters.view",
  "input_schema": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "$defs": {
    "citation": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "doc_id",
      "version_id",
      "page",
      "line_start",
      "line_end",
      "quote_hash"
     ],
     "properties": {
      "doc_id": {
       "type": "string",
       "format": "uuid"
      },
      "version_id": {
       "type": "string",
       "format": "uuid"
      },
      "page": {
       "type": "integer",
       "minimum": 1
      },
      "line_start": {
       "type": "integer",
       "minimum": 1
      },
      "line_end": {
       "type": "integer",
       "minimum": 1
      },
      "quote_hash": {
       "type": "string",
       "pattern": "^sha256:[0-9a-f]{64}$"
      }
     }
    },
    "cents": {
     "type": "integer",
     "minimum": 0,
     "maximum": 100000000000
    },
    "uuid": {
     "type": "string",
     "format": "uuid"
    },
    "date": {
     "type": "string",
     "format": "date"
    }
   },
   "type": "object",
   "additionalProperties": false,
   "required": [
    "query"
   ],
   "properties": {
    "query": {
     "type": "string",
     "maxLength": 200
    },
    "status": {
     "enum": [
      "open",
      "pending",
      "closed"
     ]
    },
    "cursor": {
     "type": "string"
    },
    "limit": {
     "type": "integer",
     "minimum": 1,
     "maximum": 50,
     "default": 20
    }
   }
  }
 },
