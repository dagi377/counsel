{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "CONTRACT: frozen once on main; changes are additive only and need a docs/QUESTIONS.md entry. Source: spec/eng/k1-kernel.html (Registry). Validated at boot; registered data that fails it stops boot.",
  "title": "PortalPage",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "route",
    "capability"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
      "description": "module-prefixed id, e.g. <module>.<name>"
    },
    "route": {
      "type": "string",
      "pattern": "^/[a-z0-9/_{}-]*$"
    },
    "capability": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
      "description": "module-prefixed id, e.g. <module>.<name>"
    }
  },
  "$id": "https://counsel.local/spec/kernel/portalpage.schema.json"
}
