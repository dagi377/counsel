{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "CONTRACT: frozen once on main; changes are additive only and need a docs/QUESTIONS.md entry. Source: spec/eng/k1-kernel.html (Registry). Validated at boot; registered data that fails it stops boot.",
  "title": "DocumentKind",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "description",
    "retention_class"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
      "description": "module-prefixed id, e.g. <module>.<name>"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "templates": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "classification": {
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ]
    },
    "retention_class": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
      "description": "module-prefixed id, e.g. <module>.<name>"
    }
  },
  "$id": "https://counsel.local/spec/kernel/documentkind.schema.json"
}
